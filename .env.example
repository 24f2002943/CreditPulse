# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security & Auth
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./creditpulse.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://creditpulse_user:creditpulse_pass@localhost:5432/creditpulse_db

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# ML & NLP Pipeline Configuration
USE_FAST_NLP_FALLBACK=true
SHAP_BACKGROUND_SAMPLES=100
DEFAULT_RISK_THRESHOLD=0.5

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
